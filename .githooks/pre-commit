#!/bin/sh
set -eu

echo "pre-commit: checking RAM readability guardrails"
python3 scripts/check_ram_readability.py

PRECOMMIT_MODE="${ZELDA3_PRECOMMIT_MODE:-fast}"

if [ "$PRECOMMIT_MODE" = "full" ]; then
  echo "pre-commit: building release replay binary"
  cargo build -p zelda3-bin --release
  RUST_BIN="target/release/zelda3"
else
  echo "pre-commit: building parity replay binary"
  cargo build --profile parity -p zelda3-bin
  RUST_BIN="target/parity/zelda3"
fi

snapshot_dir="$(mktemp -d "${TMPDIR:-/tmp}/zelda3-pre-commit-sram.XXXXXX")"
sram_dat_exists=0
sram_bak_exists=0
if [ -f saves/sram.dat ]; then
  cp saves/sram.dat "$snapshot_dir/sram.dat"
  sram_dat_exists=1
fi
if [ -f saves/sram.bak ]; then
  cp saves/sram.bak "$snapshot_dir/sram.bak"
  sram_bak_exists=1
fi
restore_sram() {
  if [ "$sram_dat_exists" -eq 1 ]; then
    cp "$snapshot_dir/sram.dat" saves/sram.dat
  else
    rm -f saves/sram.dat
  fi
  if [ "$sram_bak_exists" -eq 1 ]; then
    cp "$snapshot_dir/sram.bak" saves/sram.bak
  else
    rm -f saves/sram.bak
  fi
  rm -rf "$snapshot_dir"
}
trap restore_sram EXIT HUP INT TERM

echo "pre-commit: running C/R standard replay parity gate"
if [ "$PRECOMMIT_MODE" = "full" ]; then
  python3 scripts/test_standard_replay_parity.py --skip-final-frame --rust-bin "$RUST_BIN"
else
  python3 scripts/test_standard_replay_parity.py --standalone-embedded-only --rust-bin "$RUST_BIN"
  FAST_PARITY_FRAMES="${ZELDA3_FAST_PARITY_FRAMES:-1000,12000,202255,700000,1045814,1073092}"
  python3 scripts/fast_standard_replay_parity.py --rust-bin "$RUST_BIN" --frames "$FAST_PARITY_FRAMES"
fi
restore_sram
trap - EXIT HUP INT TERM

# All-layer regression gate vs the C oracle: WRAM (byte + hashes), VRAM (byte),
# SRAM, RENDER (every frame), AUDIO (DSP trace). Catches any memory/graphics/
# color-math/audio drift the checkpoint gate above doesn't cover per-frame.
# Smoke budget keeps it commit-fast; run --full for the exhaustive 170k sweep.
PARITY_FRAMES="${ZELDA3_PRECOMMIT_PARITY_FRAMES:-500}"
echo "pre-commit: all-layer parity gate vs C oracle (${PARITY_FRAMES} frames)"
if [ -x ../zelda3/zelda3 ]; then
  python3 scripts/validate_all_parity.py --frames "$PARITY_FRAMES" --audio-stride 5
else
  echo "pre-commit: WARNING — C oracle (../zelda3/zelda3) not built; skipping all-layer gate."
  echo "pre-commit: build it with 'make -C ../zelda3 zelda3' to enable the full parity gate."
fi

echo "pre-commit: for the exhaustive sweep run: scripts/validate_all_parity.py --full"
echo "pre-commit: for the old standard-route hook run: ZELDA3_PRECOMMIT_MODE=full git commit"
