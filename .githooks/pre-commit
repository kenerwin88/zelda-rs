#!/bin/sh
set -eu

echo "pre-commit: checking RAM readability guardrails"
python3 scripts/check_ram_readability.py

if [ -f generated/zelda3_assets/manifest.json ] && [ -d generated/zelda3_assets/atlas ]; then
  echo "pre-commit: checking compact RGBA atlas manifest"
  python3 scripts/variant_atlas_summary.py --require-full-stable \
    --manifest generated/zelda3_assets/manifest.json \
    generated/zelda3_assets/atlas
fi

PRECOMMIT_MODE="${ZELDA3_PRECOMMIT_MODE:-fast}"

snapshot_dir="$(mktemp -d "${TMPDIR:-/tmp}/zelda3-pre-commit-sram.XXXXXX")"
sram_dat_exists=0
sram_bak_exists=0
if [ -f saves/sram.dat ]; then
  cp saves/sram.dat "$snapshot_dir/sram.dat"
  sram_dat_exists=1
fi
if [ -f saves/sram.bak ]; then
  cp saves/sram.bak "$snapshot_dir/sram.bak"
  sram_bak_exists=1
fi
restore_sram() {
  if [ "$sram_dat_exists" -eq 1 ]; then
    cp "$snapshot_dir/sram.dat" saves/sram.dat
  else
    rm -f saves/sram.dat
  fi
  if [ "$sram_bak_exists" -eq 1 ]; then
    cp "$snapshot_dir/sram.bak" saves/sram.bak
  else
    rm -f saves/sram.bak
  fi
  rm -rf "$snapshot_dir"
}
trap restore_sram EXIT HUP INT TERM

echo "pre-commit: building parity replay binary"
cargo build --profile parity -p zelda3-bin

echo "pre-commit: running standalone smoke"
target/parity/zelda3 --standalone-smoke "${ZELDA3_STANDALONE_SMOKE_FRAMES:-500}"
restore_sram
trap - EXIT HUP INT TERM

# All-layer regression gate vs the committed C-derived golden fingerprints:
# WRAM, VRAM, SRAM, render, and audio rollups. This path intentionally never
# runs the live C oracle; zparity checks Rust output against parity-golden.
PARITY_FRAMES="${ZELDA3_PRECOMMIT_PARITY_FRAMES:-500}"
if [ "$PRECOMMIT_MODE" = "full" ]; then
  echo "pre-commit: full zparity golden sweep + GPU checkpoint sweep"
  python3 scripts/validate_all_parity.py --full
else
  echo "pre-commit: zparity golden smoke (${PARITY_FRAMES} frames)"
  python3 scripts/validate_all_parity.py --frames "$PARITY_FRAMES"
fi

echo "pre-commit: for the exhaustive sweep run: scripts/validate_all_parity.py --full"
