+void capture_dma_common(int *event, int offset)
+{
+	event[offset + 0] = CPU.V_Counter;
+	event[offset + 1] = CPU.Cycles;
+	event[offset + 2] = CPU.NextEvent;
+	event[offset + 3] = CPU.WhichEvent;
+	event[offset + 4] = Timings.H_Max;
+	event[offset + 5] = Timings.WRAMRefreshPos;
+	event[offset + 6] = Zelda3TraceCpuModelIdentity();
+	event[offset + 7] = Model->_5A22;
+	event[offset + 8] = S9xAPUCurrentReferenceTime();
+	event[offset + 9] = S9xAPUCurrentRemainder();
+	event[offset + 10] = SNES::smp.clock;
+	event[offset + 11] = SNES::smp.regs.pc;
+	event[offset + 12] = SNES::smp.opcode_number;
+	event[offset + 13] = SNES::smp.opcode_cycle;
+	event[offset + 14] = SNES::dsp.clock;
+	event[offset + 15] = SNES::dsp.spc_dsp.zelda3_debug_value(7);
+	event[offset + 16] = dsp_sample_count;
+	event[offset + 17] = Registers.PBPC & 0xffffff;
+}
