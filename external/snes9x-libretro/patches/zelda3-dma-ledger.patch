+	event[49] = dma ? dma->TransferBytes : -1;
+	event[50] = dma ? dma->AAddress : -1;
+	event[51] = dma ? dma->ABank : -1;
+	event[52] = dma ? dma->BAddress : -1;
+	event[53] = PPU.VMA.Address;
+	event[54] = PPU.VMA.Increment;
+	event[55] = PPU.VMA.High;
+	event[56] = PPU.VMA.FullGraphicCount;
+	event[57] = PPU.OAMAddr;
+	event[58] = PPU.CGADD;
