+
+void Zelda3TraceCaptureRenderedPpuRange(int start_line, int end_line)
+{
+	if (start_line < 0)
+		start_line = 0;
+	if (end_line >= SNES_HEIGHT_EXTENDED)
+		end_line = SNES_HEIGHT_EXTENDED - 1;
+	if (start_line > end_line)
+		return;
+	const uint8 inidisp = Memory.FillRAM[0x2100];
+	for (int line = start_line; line <= end_line; line++)
+		scanout_inidisp[line] = inidisp;
+	if (!scanout_hud_tilemap_valid && !(inidisp & 0x80) &&
+		start_line < presented_hud_end_line && end_line >= presented_hud_first_line)
+	{
+		std::memcpy(scanout_hud_tilemap,
+			Memory.VRAM + presented_hud_word_address * 2,
+			sizeof(scanout_hud_tilemap));
+		scanout_hud_tilemap_valid = true;
+	}
+}
