+int Zelda3TracePresentedBgTilemapMetaValue(int index)
+{
+	if (!presented_bg_tilemaps_valid)
+		return -2;
+	if (index == 0)
+		return 1;
+	const int layer = (index - 1) / 5;
+	const int field = (index - 1) % 5;
+	if (layer < 0 || layer >= presented_bg_layer_count)
+		return -1;
+	const int size = presented_bg_tilemap_size[layer] & 3;
+	const int word_count = 1024 << ((size & 1 ? 1 : 0) + (size & 2 ? 1 : 0));
+	if (field == 0)
+		return presented_bg_tilemap_base[layer];
+	if (field == 1)
+		return size;
+	if (field == 2)
+		return word_count;
+	uint32 hash = 2166136261u;
+	for (int offset = 0; offset < word_count; offset++)
+	{
+		const int byte_address =
+			((presented_bg_tilemap_base[layer] + offset) & 0x7fff) << 1;
+		hash = (hash ^ presented_vram[byte_address]) * 16777619u;
+		hash = (hash ^ presented_vram[byte_address + 1]) * 16777619u;
+	}
+	return field == 3 ? static_cast<int>(hash & 0xffff) :
+		static_cast<int>(hash >> 16);
+}
+
+int Zelda3TracePresentedBgTilemapWordValue(int index)
+{
+	if (!presented_bg_tilemaps_valid || index < 0)
+		return presented_bg_tilemaps_valid ? -1 : -2;
+	const int layer = index / presented_bg_max_words;
+	const int offset = index % presented_bg_max_words;
+	if (layer < 0 || layer >= presented_bg_layer_count)
+		return -1;
+	const int size = presented_bg_tilemap_size[layer] & 3;
+	const int word_count = 1024 << ((size & 1 ? 1 : 0) + (size & 2 ? 1 : 0));
+	if (offset >= word_count)
+		return -1;
+	const int byte_address =
+		((presented_bg_tilemap_base[layer] + offset) & 0x7fff) << 1;
+	return presented_vram[byte_address] |
+		(presented_vram[byte_address + 1] << 8);
+}
