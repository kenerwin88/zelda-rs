 TraceConfig config = {};
 uint64 retro_run_index = 0;
+
+// Binary trace record format "Z3TRACE1": the file begins with that 8-byte
+// magic; every record is a little-endian u16 length followed by a fixed
+// 106-byte machine-state header and a tag/length/value tail. The Rust
+// decoder (crates/parity/src/trace_format.rs) and the Python decoder
+// (scripts/snes9x_trace_format.py) mirror this layout exactly.
+constexpr unsigned trace_record_capacity = 4096;
+uint8 trace_record[trace_record_capacity];
+unsigned trace_record_length = 0;
+uint8 trace_tlv_scratch[256];
+
+enum TraceRecordKind : uint8
+{
+	RECORD_FRAME = 1,
+	RECORD_VIDEO = 2,
+	RECORD_NMI = 3,
+	RECORD_NMI_RESUME = 4,
+	RECORD_PC = 5,
+	RECORD_DMA = 6,
+	RECORD_HDMA_START = 7,
+	RECORD_HDMA_END = 8,
+	RECORD_RNG_PPU_READ = 9,
+	RECORD_PPU_READ = 10,
+	RECORD_PPU_WRITE = 11,
+	RECORD_RNG_WRITE = 12,
+	RECORD_WRAM_WRITE = 13,
+	RECORD_PIXEL_WRITE = 14,
+};
+
+enum TraceRecordStage : uint8
+{
+	STAGE_NONE = 0,
+	STAGE_ENTRY = 1,
+	STAGE_RETURN = 2,
+	STAGE_PRESENTED = 3,
+};
+
+enum TraceTag : uint8
+{
+	TAG_ADDRESS = 1,
+	TAG_VALUE = 2,
+	TAG_H_LATCHED = 3,
+	TAG_CHANNEL = 4,
+	TAG_SOURCE = 5,
+	TAG_B_ADDRESS = 6,
+	TAG_BYTES = 7,
+	TAG_MODE = 8,
+	TAG_FIXED = 9,
+	TAG_DECREMENT = 10,
+	TAG_VRAM_ADDRESS = 11,
+	TAG_CHANNELS = 12,
+	TAG_CHANNEL_STATE = 13,
+	TAG_PIX = 20,
+	TAG_Z1 = 21,
+	TAG_Z2 = 22,
+	TAG_TILE = 23,
+	TAG_TILE_NUMBER = 24,
+	TAG_TILE_ADDRESS = 25,
+	TAG_TILE_CACHE_VALID = 26,
+	TAG_TILE_CACHE_HASH = 27,
+	TAG_OBJ_TILE = 28,
+	TAG_OBJ_LINE = 29,
+	TAG_OBJ_X = 30,
+	TAG_OBJ_Y = 31,
+	TAG_OBJ_CACHE = 32,
+	TAG_OBJ_TILE_NUMBER = 33,
+	TAG_OBJ_CACHE_VALID = 34,
+	TAG_OBJ_CACHE_HASH = 35,
+};
+
+inline void record_u8(uint32 value)
+{
+	if (trace_record_length < trace_record_capacity)
+		trace_record[trace_record_length++] = (uint8) value;
+}
+
+inline void record_u16(uint32 value)
+{
+	record_u8(value & 0xff);
+	record_u8((value >> 8) & 0xff);
+}
+
+inline void record_u32(uint32 value)
+{
+	record_u16(value & 0xffff);
+	record_u16((value >> 16) & 0xffff);
+}
+
+inline void record_u64(uint64 value)
+{
+	record_u32((uint32) (value & 0xffffffffu));
+	record_u32((uint32) (value >> 32));
+}
+
+inline void record_tlv(uint8 tag, const uint8 *payload, unsigned length)
+{
+	if (length > 255 || trace_record_length + 2 + length > trace_record_capacity)
+		return;
+	record_u8(tag);
+	record_u8(length);
+	for (unsigned index = 0; index < length; index++)
+		record_u8(payload[index]);
+}
+
+inline void record_tlv_u8(uint8 tag, uint32 value)
+{
+	const uint8 payload[1] = { (uint8) value };
+	record_tlv(tag, payload, 1);
+}
+
+inline void record_tlv_u16(uint8 tag, uint32 value)
+{
+	const uint8 payload[2] = { (uint8) (value & 0xff), (uint8) ((value >> 8) & 0xff) };
+	record_tlv(tag, payload, 2);
+}
+
+inline void record_tlv_u32(uint8 tag, uint32 value)
+{
+	const uint8 payload[4] = {
+		(uint8) (value & 0xff), (uint8) ((value >> 8) & 0xff),
+		(uint8) ((value >> 16) & 0xff), (uint8) ((value >> 24) & 0xff),
+	};
+	record_tlv(tag, payload, 4);
+}
+
+inline void record_tlv_i32(uint8 tag, int32 value)
+{
+	record_tlv_u32(tag, (uint32) value);
+}
+
+inline void record_stage(TraceRecordStage stage)
+{
+	if (trace_record_length > 1)
+		trace_record[1] = (uint8) stage;
+}
