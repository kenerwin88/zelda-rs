+extern "C" int zelda3_snes9x_debug_ppu_value(int field, int index)
+{
+    switch (field)
+    {
+        case 0: return PPU.BGMode;
+        case 1: return PPU.Brightness;
+        case 2: return index >= 0 && index < 256 ? PPU.CGDATA[index] : -1;
+        case 4:
+            if (index == 0) return PPU.FixedColourRed;
+            if (index == 1) return PPU.FixedColourGreen;
+            if (index == 2) return PPU.FixedColourBlue;
+            return -1;
+        case 7: return PPU.ForcedBlanking ? 1 : 0;
+        case 14:
+            if (index < 0 || index >= 8) return -1;
+            return index & 1 ? PPU.BG[index >> 1].VOffset : PPU.BG[index >> 1].HOffset;
+        case 15: return index >= 0 && index < 544 ? PPU.OAMData[index] : -1;
+        case 16: return index >= 0 && index < 6 ? Memory.FillRAM[0x212c + index] : -1;
+        case 17:
+            if (index == 0) return PPU.OBJNameBase;
+            if (index == 1) return PPU.OBJNameSelect;
+            if (index == 2) return PPU.OBJSizeSelect;
+            return -1;
+        case 18:
+            return index >= 0 && index < 512
+                ? Memory.VRAM[0x7600 + index * 2] |
+                    (Memory.VRAM[0x7601 + index * 2] << 8)
+                : -1;
+        case 19:
+            if (index == 0) return PPU.FirstSprite;
+            if (index == 1) return PPU.OAMPriorityRotation;
+            if (index == 2) return PPU.OAMFlip;
+            if (index == 3) return PPU.OAMAddr;
+            if (index == 4) return PPU.SavedOAMAddr;
+            return -1;
+        case 20: return Zelda3TracePresentedOamValue(index);
+        // GFX retains the evaluated OBJ lists used by the most recently
+        // rendered scanlines, even when VBlank DMA has already changed PPU.OAM.
+        case 21: return Zelda3TracePresentedObjValue(0, index);
+        case 22: return Zelda3TracePresentedObjValue(1, index);
+        case 23: return Zelda3TracePresentedObjValue(2, index);
+        case 24: return Zelda3TracePresentedObjValue(3, index);
+        case 25: return Zelda3TracePresentedObjValue(4, index);
+        case 26: return Zelda3TracePresentedObjValue(5, index);
+        // Flattened [main/sub][BG1..backdrop] ClipData snapshots. Each clip
+        // contributes Count followed by six (DrawMode, Left, Right) spans.
+        case 27: return Zelda3TracePresentedClipValue(index);
+        // Selected pixel's final winning draw:
+        // offset, palette index, main, sub, sub depth, result, Z1, Z2,
+        // clip-colors, layer-math-enable.
+        case 28: return Zelda3TracePresentedPixelValue(index);
+        default: return -1;
+    }
+}
