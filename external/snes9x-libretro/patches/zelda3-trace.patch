+void Zelda3TraceCaptureSmpInstruction(int pc, int opcode, int a, int x, int y, int sp,
+	int psw, int timer0_stage1, int timer0_stage2, int timer0_stage3)
+{
+	if (smp_instruction_count >= smp_instruction_capacity)
+		return;
+	int *instruction = smp_instructions[smp_instruction_count++];
+	instruction[0] = pc;
+	instruction[1] = opcode;
+	instruction[2] = a;
+	instruction[3] = x;
+	instruction[4] = y;
+	instruction[5] = sp;
+	instruction[6] = psw;
+	instruction[7] = timer0_stage1;
+	instruction[8] = timer0_stage2;
+	instruction[9] = timer0_stage3;
+	instruction[10] = dsp_sample_count;
+	instruction[11] = SNES::dsp.spc_dsp.zelda3_debug_value(7);
+	instruction[12] = SNES::smp.clock;
+}
+
+int Zelda3TraceSmpInstructionCount()
+{
+	return smp_instruction_count;
+}
+
+int Zelda3TraceSmpInstructionValue(int instruction, int field)
+{
+	return instruction >= 0 && instruction < smp_instruction_count &&
+		field >= 0 && field < smp_instruction_field_count
+		? smp_instructions[instruction][field] : -1;
+}
+
+void Zelda3TraceRetroRunBegin()
+{
+	std::fill_n(presented_pixel, presented_pixel_field_count, -1);
+	dsp_sample_count = 0;
+	dsp_write_count = 0;
+	apu_port_write_count = 0;
+	smp_instruction_count = 0;
+	if (!active(TRACE_FRAME))
+		return;
+	write_machine_state("frame");
+	std::fputs(",\"stage\":\"entry\"", config.output);
+	finish_event();
+}
+
+void Zelda3TraceRetroRunEnd()
+{
+	if (active(TRACE_FRAME))
+	{
+		write_machine_state("frame");
+		std::fputs(",\"stage\":\"return\"", config.output);
+		finish_event();
+	}
+	retro_run_index++;
+}
+
+void Zelda3TraceInstruction(void)
+{
+	if (!active(TRACE_PC))
+		return;
+	const uint32 pc = Registers.PBPC & 0xffffff;
+	if (includes(config.pc, config.pc_count, pc))
+	{
+		write_machine_state("pc");
+		finish_event();
+	}
+}
+
+void Zelda3TraceNmi(void)
+{
+	if (!active(TRACE_NMI))
+		return;
+	write_machine_state("nmi");
+	finish_event();
+}
+
+void Zelda3TraceDma(uint8 channel, const SDMA *dma)
+{
+	if (!active(TRACE_DMA))
+		return;
+	write_machine_state("dma");
+	std::fprintf(config.output,
+		",\"channel\":%u,\"source\":%u,\"b_address\":%u,\"bytes\":%u,"
+		"\"mode\":%u,\"fixed\":%u,\"decrement\":%u,\"vram_address\":%u",
+		channel, ((uint32) dma->ABank << 16) | dma->AAddress, dma->BAddress,
+		dma->TransferBytes ? dma->TransferBytes : 0x10000,
+		dma->TransferMode, dma->AAddressFixed, dma->AAddressDecrement, PPU.VMA.Address);
+	finish_event();
+}
+
+void Zelda3TraceHdma(const char *phase, uint8 channels)
+{
+	if (!active(TRACE_HDMA))
+		return;
+	write_machine_state(phase[0] == 's' ? "hdma-start" : "hdma-end");
+	std::fprintf(config.output, ",\"channels\":%u", channels);
+	finish_event();
+}
+
+void Zelda3TracePpuRead(uint16 address, uint8 value)
+{
+	const bool rng = address == 0x2137 || address == 0x213c;
+	if ((!rng || !active(TRACE_RNG)) &&
+		(!active(TRACE_PPU) || !includes(config.ppu, config.ppu_count, address)))
+		return;
+	write_machine_state(rng ? "rng-ppu-read" : "ppu-read");
+	std::fprintf(config.output, ",\"address\":%u,\"value\":%u,\"h_latched\":%u",
+		address, value, PPU.HBeamPosLatched);
+	finish_event();
+}
+
+void Zelda3TracePpuWrite(uint16 address, uint8 value)
+{
+	if (!active(TRACE_PPU) || !includes(config.ppu, config.ppu_count, address))
+		return;
+	write_machine_state("ppu-write");
+	std::fprintf(config.output, ",\"address\":%u,\"value\":%u", address, value);
+	finish_event();
+}
+
+void Zelda3TraceWramWrite(uint32 address, uint8 value)
+{
+	const uint32 bank = (address >> 16) & 0xff;
+	const uint32 offset = address & 0xffff;
+	const bool wram_bank = bank == 0x7e || bank == 0x7f || bank <= 0x3f ||
+		(bank >= 0x80 && bank <= 0xbf);
+	if (!wram_bank)
+		return;
+	const bool rng = offset == 0x0fa1;
+	if ((!rng || !active(TRACE_RNG)) &&
+		(!active(TRACE_WRAM) || !includes(config.wram, config.wram_count, offset)))
+		return;
+	write_machine_state(rng ? "rng-write" : "wram-write");
+	std::fprintf(config.output, ",\"address\":%u,\"value\":%u", offset, value);
+	finish_event();
+}
