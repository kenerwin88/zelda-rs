+void SNES::Zelda3TraceCaptureDspSample(const SPC_DSP *dsp, int left, int right)
+{
+	if (dsp_sample_count >= dsp_sample_capacity)
+		return;
+	int *sample = dsp_samples[dsp_sample_count++];
+	sample[0] = left;
+	sample[1] = right;
+	for (int field = 2; field < dsp_field_count; field++)
+		sample[field] = dsp->zelda3_debug_value(field);
+	sample[151] = dsp_raw_main[0];
+	sample[152] = dsp_raw_main[1];
+	for (int voice = 0; voice < 8; voice++)
+	{
+		sample[153 + voice * 2] = dsp_voice_output[voice][0];
+		sample[154 + voice * 2] = dsp_voice_output[voice][1];
+		sample[169 + voice] = dsp_voice_pipeline_output[voice];
+		for (int field = 0; field < 5; field++)
+			sample[177 + voice * 5 + field] = dsp_interpolation[voice][field];
+	}
+}
+
+void SNES::Zelda3TraceCaptureDspRawMain(int left, int right)
+{
+	dsp_raw_main[0] = left;
+	dsp_raw_main[1] = right;
+}
+
+void SNES::Zelda3TraceCaptureDspVoiceOutput(
+	int voice, int channel, int output, int pipeline_output)
+{
+	if (voice >= 0 && voice < 8 && channel >= 0 && channel < 2)
+	{
+		dsp_voice_output[voice][channel] = output;
+		dsp_voice_pipeline_output[voice] = pipeline_output;
+	}
+}
+
+void SNES::Zelda3TraceCaptureDspInterpolation(
+	int voice, int offset, int oldest, int older, int old, int newest)
+{
+	if (voice < 0 || voice >= 8)
+		return;
+	dsp_interpolation[voice][0] = offset;
+	dsp_interpolation[voice][1] = oldest;
+	dsp_interpolation[voice][2] = older;
+	dsp_interpolation[voice][3] = old;
+	dsp_interpolation[voice][4] = newest;
+}
+
+int Zelda3TraceDspSampleCount()
+{
+	return dsp_sample_count;
+}
+
+int Zelda3TraceDspFieldCount()
+{
+	return dsp_field_count;
+}
+
+int Zelda3TraceDspSampleValue(int sample, int field)
+{
+	return sample >= 0 && sample < dsp_sample_count &&
+		field >= 0 && field < dsp_field_count
+		? dsp_samples[sample][field] : -1;
+}
+
+void SNES::Zelda3TraceCaptureDspWrite(const SPC_DSP *dsp, int reg, int value)
+{
+	if (dsp_write_count >= dsp_write_capacity)
+		return;
+	int *write = dsp_writes[dsp_write_count++];
+	write[0] = reg;
+	write[1] = value;
+	write[2] = dsp_sample_count;
+	write[3] = dsp->zelda3_debug_value(7);
+}
+
+int Zelda3TraceDspWriteCount()
+{
+	return dsp_write_count;
+}
+
+int Zelda3TraceDspWriteValue(int write, int field)
+{
+	return write >= 0 && write < dsp_write_count &&
+		field >= 0 && field < dsp_write_field_count
+		? dsp_writes[write][field] : -1;
+}
+
+void Zelda3TraceCaptureApuPortWrite(int port, int value)
+{
+	if (apu_port_write_count >= apu_port_write_capacity)
+		return;
+	int *write = apu_port_writes[apu_port_write_count++];
+	write[0] = port;
+	write[1] = value;
+	write[2] = dsp_sample_count;
+	write[3] = CPU.V_Counter;
+	write[4] = CPU.Cycles;
+	write[5] = Registers.PBPC & 0xffffff;
+	write[6] = dsp_sample_count * 32 +
+		SNES::dsp.spc_dsp.zelda3_debug_value(7) + SNES::dsp.clock;
+	write[7] = -1;
+	write[8] = SNES::smp.clock;
+	write[9] = -1;
+	write[10] = SNES::dsp.clock;
+	write[11] = -1;
+	write[12] = SNES::dsp.spc_dsp.zelda3_debug_value(7);
+	write[13] = -1;
+	write[14] = SNES::smp.regs.pc;
+	write[15] = -1;
+	write[16] = SNES::smp.opcode_number;
+	write[17] = -1;
+	write[18] = SNES::smp.opcode_cycle;
+	write[19] = -1;
+	write[20] = 0;
+}
+
+void Zelda3TraceFinalizeApuPortWrite()
+{
+	if (apu_port_write_count == 0)
+		return;
+	int *write = apu_port_writes[apu_port_write_count - 1];
+	write[7] = dsp_sample_count * 32 +
+		SNES::dsp.spc_dsp.zelda3_debug_value(7) + SNES::dsp.clock;
+	write[9] = SNES::smp.clock;
+	write[11] = SNES::dsp.clock;
+	write[13] = SNES::dsp.spc_dsp.zelda3_debug_value(7);
+	write[15] = SNES::smp.regs.pc;
+	write[17] = SNES::smp.opcode_number;
+	write[19] = SNES::smp.opcode_cycle;
+}
+
+void Zelda3TraceCaptureApuPortRead(int port)
+{
+	Zelda3TraceCaptureApuPortWrite(port, -1);
+	apu_port_writes[apu_port_write_count - 1][20] = 1;
+}
+
+void Zelda3TraceFinalizeApuPortRead(int value)
+{
+	Zelda3TraceFinalizeApuPortWrite();
+	apu_port_writes[apu_port_write_count - 1][1] = value;
+}
+
+int Zelda3TraceApuPortWriteCount()
+{
+	return apu_port_write_count;
+}
+
+int Zelda3TraceApuPortWriteValue(int write, int field)
+{
+	return write >= 0 && write < apu_port_write_count &&
+		field >= 0 && field < apu_port_write_field_count
+		? apu_port_writes[write][field] : -1;
+}
