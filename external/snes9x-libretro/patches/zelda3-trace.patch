+int SPC_DSP::zelda3_debug_value( int field ) const
+{
+	switch ( field )
+	{
+		case 2: return m.counter;
+		case 3: return m.every_other_sample;
+		case 4: return m.kon;
+		case 5: return m.new_kon;
+		case 6: return m.t_koff;
+		case 7: return m.phase;
+		case 8: return REG(koff);
+		case 9: return REG(kon);
+		case 10: return REG(flg);
+		case 11: return m.t_output;
+		case 12: return m.t_pmon;
+		case 13: return m.t_non;
+		case 14: return m.t_eon;
+		case 15: return m.t_dir;
+		case 128: return m.t_echo_in [0];
+		case 129: return m.t_echo_in [1];
+		case 130: return m.t_echo_out [0];
+		case 131: return m.t_echo_out [1];
+		case 132: return m.echo_offset;
+		case 133: return m.echo_length;
+		case 134: return (int) (m.echo_hist_pos - m.echo_hist);
+	}
+
+	if ( field >= 135 && field < 151 )
+	{
+		const int channel = (field - 135) / 8;
+		const int tap = (field - 135) % 8;
+		return m.echo_hist_pos [tap] [channel];
+	}
+
+	if ( field < 16 )
+		return 0;
+	const int voice_index = (field - 16) / 14;
+	const int voice_field = (field - 16) % 14;
+	if ( voice_index >= voice_count )
+		return -1;
+	const voice_t &voice = m.voices [voice_index];
+	switch ( voice_field )
+	{
+		case 0: return voice.env;
+		case 1: return voice.hidden_env;
+		case 2: return voice.env_mode;
+		case 3: return voice.kon_delay;
+		case 4: return voice.interp_pos;
+		case 5: return voice.brr_addr;
+		case 6: return voice.brr_offset;
+		case 7: return voice.t_envx_out;
+		case 8: return VREG(voice.regs, voll);
+		case 9: return VREG(voice.regs, volr);
+		case 10:
+			return VREG(voice.regs, pitchl) |
+				(VREG(voice.regs, pitchh) << 8);
+		case 11: return VREG(voice.regs, adsr0);
+		case 12: return VREG(voice.regs, adsr1);
+		case 13: return VREG(voice.regs, gain);
+		default: return -1;
+	}
+}
