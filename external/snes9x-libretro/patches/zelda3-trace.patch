diff --git a/zelda3_trace.cpp b/zelda3_trace.cpp
new file mode 100644
index 0000000..6902398
--- /dev/null
+++ b/zelda3_trace.cpp
@@ -0,0 +1,311 @@
+#include "zelda3_trace.h"
+
+#include "dma.h"
+#include "memmap.h"
+#include "ppu.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+bool Zelda3TraceDmaEnabled = false;
+bool Zelda3TracePcEnabled = false;
+bool Zelda3TracePpuEnabled = false;
+bool Zelda3TraceWramEnabled = false;
+
+namespace
+{
+
+enum TraceEvent
+{
+	TRACE_FRAME = 1 << 0,
+	TRACE_NMI = 1 << 1,
+	TRACE_RNG = 1 << 2,
+	TRACE_PC = 1 << 3,
+	TRACE_DMA = 1 << 4,
+	TRACE_PPU = 1 << 5,
+	TRACE_WRAM = 1 << 6,
+};
+
+struct AddressRange
+{
+	uint32 first;
+	uint32 last;
+};
+
+struct TraceConfig
+{
+	bool initialized;
+	FILE *output;
+	uint32 events;
+	uint32 first_frame;
+	uint32 last_frame;
+	AddressRange pc[64];
+	unsigned pc_count;
+	AddressRange ppu[32];
+	unsigned ppu_count;
+	AddressRange wram[32];
+	unsigned wram_count;
+};
+
+TraceConfig config = {};
+uint64 retro_run_index = 0;
+uint8 presented_oam[544] = {};
+
+uint32 parse_hex(const char *text, const char **end)
+{
+	char normalized[32];
+	unsigned length = 0;
+	while (*text && *text != ',' && *text != '-' && length + 1 < sizeof(normalized))
+	{
+		if (*text != ':' && *text != '$')
+			normalized[length++] = *text;
+		text++;
+	}
+	normalized[length] = '\0';
+	char *parsed_end = nullptr;
+	const uint32 value = (uint32) std::strtoul(normalized, &parsed_end, 16);
+	*end = text;
+	return parsed_end != normalized ? value : 0xffffffff;
+}
+
+void parse_ranges(const char *text, AddressRange *ranges, unsigned capacity, unsigned *count)
+{
+	*count = 0;
+	while (text && *text && *count < capacity)
+	{
+		const char *end = nullptr;
+		const uint32 first = parse_hex(text, &end);
+		if (first == 0xffffffff)
+			break;
+		uint32 last = first;
+		if (*end == '-')
+		{
+			text = end + 1;
+			last = parse_hex(text, &end);
+			if (last == 0xffffffff)
+				break;
+		}
+		ranges[*count].first = first;
+		ranges[*count].last = last;
+		(*count)++;
+		text = *end == ',' ? end + 1 : end;
+	}
+}
+
+bool has_token(const char *list, const char *token)
+{
+	if (!list || !*list)
+		return false;
+	const size_t token_length = std::strlen(token);
+	for (const char *p = list; *p;)
+	{
+		while (*p == ',' || *p == ' ')
+			p++;
+		const char *end = p;
+		while (*end && *end != ',')
+			end++;
+		if ((size_t) (end - p) == token_length && std::strncmp(p, token, token_length) == 0)
+			return true;
+		p = end;
+	}
+	return false;
+}
+
+void initialize()
+{
+	if (config.initialized)
+		return;
+	config.initialized = true;
+	config.first_frame = 0;
+	config.last_frame = 0xffffffff;
+
+	const char *path = std::getenv("ZELDA3_SNES9X_TRACE");
+	if (!path || !*path)
+		return;
+	config.output = std::fopen(path, "a");
+	if (!config.output)
+		return;
+
+	const char *events = std::getenv("ZELDA3_SNES9X_TRACE_EVENTS");
+	if (!events || !*events)
+		events = "frame,nmi,rng";
+	if (has_token(events, "frame")) config.events |= TRACE_FRAME;
+	if (has_token(events, "nmi")) config.events |= TRACE_NMI;
+	if (has_token(events, "rng")) config.events |= TRACE_RNG;
+	if (has_token(events, "pc")) config.events |= TRACE_PC;
+	if (has_token(events, "dma")) config.events |= TRACE_DMA;
+	if (has_token(events, "ppu")) config.events |= TRACE_PPU;
+	if (has_token(events, "wram")) config.events |= TRACE_WRAM;
+	Zelda3TraceDmaEnabled = (config.events & TRACE_DMA) != 0;
+	Zelda3TracePcEnabled = (config.events & TRACE_PC) != 0;
+	Zelda3TracePpuEnabled = (config.events & TRACE_PPU) != 0;
+	Zelda3TraceWramEnabled = (config.events & (TRACE_RNG | TRACE_WRAM)) != 0;
+
+	const char *frames = std::getenv("ZELDA3_SNES9X_TRACE_FRAMES");
+	if (frames && *frames)
+	{
+		char *end = nullptr;
+		config.first_frame = (uint32) std::strtoul(frames, &end, 10);
+		config.last_frame = config.first_frame;
+		if (*end == '-')
+			config.last_frame = (uint32) std::strtoul(end + 1, nullptr, 10);
+	}
+
+	parse_ranges(std::getenv("ZELDA3_SNES9X_TRACE_PCS"), config.pc, 64, &config.pc_count);
+	parse_ranges(std::getenv("ZELDA3_SNES9X_TRACE_PPU"), config.ppu, 32, &config.ppu_count);
+	parse_ranges(std::getenv("ZELDA3_SNES9X_TRACE_WRAM"), config.wram, 32, &config.wram_count);
+}
+
+bool active(uint32 event)
+{
+	initialize();
+	return config.output && (config.events & event) &&
+		IPPU.TotalEmulatedFrames >= config.first_frame &&
+		IPPU.TotalEmulatedFrames <= config.last_frame;
+}
+
+bool includes(const AddressRange *ranges, unsigned count, uint32 value)
+{
+	for (unsigned i = 0; i < count; i++)
+		if (value >= ranges[i].first && value <= ranges[i].last)
+			return true;
+	return false;
+}
+
+void write_machine_state(const char *event)
+{
+	const uint32 return_address =
+		Memory.RAM[(Registers.S.W + 1) & 0xffff] |
+		(Memory.RAM[(Registers.S.W + 2) & 0xffff] << 8) |
+		(Memory.RAM[(Registers.S.W + 3) & 0xffff] << 16);
+	std::fprintf(config.output,
+		"{\"event\":\"%s\",\"run\":%llu,\"frame\":%u,\"v\":%d,\"cycles\":%d,"
+		"\"pc\":%u,\"a\":%u,\"x\":%u,\"y\":%u,\"s\":%u,"
+		"\"carry\":%u,"
+		"\"main\":%u,\"sub\":%u,\"subsub\":%u,\"frame_counter\":%u,"
+		"\"rng_seed\":%u,\"nmi_latch\":%u,\"nmi_disable\":%u,\"nmi_pending\":%u,"
+		"\"return_address\":%u,"
+		"\"stack1\":%u,\"stack2\":%u,\"stack3\":%u,\"stack4\":%u",
+		event, (unsigned long long) retro_run_index, IPPU.TotalEmulatedFrames,
+		CPU.V_Counter, CPU.Cycles,
+		Registers.PBPC & 0xffffff, Registers.A.W, Registers.X.W, Registers.Y.W,
+		Registers.S.W, Zelda3TraceCpuCarry(),
+		Memory.RAM[0x10], Memory.RAM[0x11], Memory.RAM[0xb0],
+		Memory.RAM[0x1a], Memory.RAM[0x0fa1], Memory.RAM[0x12],
+		Memory.RAM[0x0710], Memory.RAM[0x17], return_address,
+		Memory.RAM[(Registers.S.W + 1) & 0xffff],
+		Memory.RAM[(Registers.S.W + 2) & 0xffff],
+		Memory.RAM[(Registers.S.W + 3) & 0xffff],
+		Memory.RAM[(Registers.S.W + 4) & 0xffff]);
+}
+
+void finish_event()
+{
+	std::fputs("}\n", config.output);
+	std::fflush(config.output);
+}
+
+}
+
+void Zelda3TraceCapturePresentedPpuState()
+{
+	std::memcpy(presented_oam, PPU.OAMData, sizeof(presented_oam));
+}
+
+int Zelda3TracePresentedOamValue(int index)
+{
+	return index >= 0 && index < (int) sizeof(presented_oam) ? presented_oam[index] : -1;
+}
+
+void Zelda3TraceRetroRunBegin()
+{
+	if (!active(TRACE_FRAME))
+		return;
+	write_machine_state("frame");
+	std::fputs(",\"stage\":\"entry\"", config.output);
+	finish_event();
+}
+
+void Zelda3TraceRetroRunEnd()
+{
+	if (active(TRACE_FRAME))
+	{
+		write_machine_state("frame");
+		std::fputs(",\"stage\":\"return\"", config.output);
+		finish_event();
+	}
+	retro_run_index++;
+}
+
+void Zelda3TraceInstruction(void)
+{
+	if (!active(TRACE_PC))
+		return;
+	const uint32 pc = Registers.PBPC & 0xffffff;
+	if (includes(config.pc, config.pc_count, pc))
+	{
+		write_machine_state("pc");
+		finish_event();
+	}
+}
+
+void Zelda3TraceNmi(void)
+{
+	if (!active(TRACE_NMI))
+		return;
+	write_machine_state("nmi");
+	finish_event();
+}
+
+void Zelda3TraceDma(uint8 channel, const SDMA *dma)
+{
+	if (!active(TRACE_DMA))
+		return;
+	write_machine_state("dma");
+	std::fprintf(config.output,
+		",\"channel\":%u,\"source\":%u,\"b_address\":%u,\"bytes\":%u,"
+		"\"mode\":%u,\"fixed\":%u,\"decrement\":%u,\"vram_address\":%u",
+		channel, ((uint32) dma->ABank << 16) | dma->AAddress, dma->BAddress,
+		dma->TransferBytes ? dma->TransferBytes : 0x10000,
+		dma->TransferMode, dma->AAddressFixed, dma->AAddressDecrement, PPU.VMA.Address);
+	finish_event();
+}
+
+void Zelda3TracePpuRead(uint16 address, uint8 value)
+{
+	const bool rng = address == 0x2137 || address == 0x213c;
+	if ((!rng || !active(TRACE_RNG)) &&
+		(!active(TRACE_PPU) || !includes(config.ppu, config.ppu_count, address)))
+		return;
+	write_machine_state(rng ? "rng-ppu-read" : "ppu-read");
+	std::fprintf(config.output, ",\"address\":%u,\"value\":%u,\"h_latched\":%u",
+		address, value, PPU.HBeamPosLatched);
+	finish_event();
+}
+
+void Zelda3TracePpuWrite(uint16 address, uint8 value)
+{
+	if (!active(TRACE_PPU) || !includes(config.ppu, config.ppu_count, address))
+		return;
+	write_machine_state("ppu-write");
+	std::fprintf(config.output, ",\"address\":%u,\"value\":%u", address, value);
+	finish_event();
+}
+
+void Zelda3TraceWramWrite(uint32 address, uint8 value)
+{
+	const uint32 bank = (address >> 16) & 0xff;
+	const uint32 offset = address & 0xffff;
+	const bool wram_bank = bank == 0x7e || bank == 0x7f || bank <= 0x3f ||
+		(bank >= 0x80 && bank <= 0xbf);
+	if (!wram_bank)
+		return;
+	const bool rng = offset == 0x0fa1;
+	if ((!rng || !active(TRACE_RNG)) &&
+		(!active(TRACE_WRAM) || !includes(config.wram, config.wram_count, offset)))
+		return;
+	write_machine_state(rng ? "rng-write" : "wram-write");
+	std::fprintf(config.output, ",\"address\":%u,\"value\":%u", offset, value);
+	finish_event();
+}
