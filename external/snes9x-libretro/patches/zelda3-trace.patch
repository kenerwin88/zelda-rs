+uint32 parse_hex(const char *text, const char **end)
+{
+	char normalized[32];
+	unsigned length = 0;
+	while (*text && *text != ',' && *text != '-' && length + 1 < sizeof(normalized))
+	{
+		if (*text != ':' && *text != '$')
+			normalized[length++] = *text;
+		text++;
+	}
+	normalized[length] = '\0';
+	char *parsed_end = nullptr;
+	const uint32 value = (uint32) std::strtoul(normalized, &parsed_end, 16);
+	*end = text;
+	return parsed_end != normalized ? value : 0xffffffff;
+}
+
+void parse_ranges(const char *text, AddressRange *ranges, unsigned capacity, unsigned *count)
+{
+	*count = 0;
+	while (text && *text && *count < capacity)
+	{
+		const char *end = nullptr;
+		const uint32 first = parse_hex(text, &end);
+		if (first == 0xffffffff)
+			break;
+		uint32 last = first;
+		if (*end == '-')
+		{
+			text = end + 1;
+			last = parse_hex(text, &end);
+			if (last == 0xffffffff)
+				break;
+		}
+		ranges[*count].first = first;
+		ranges[*count].last = last;
+		(*count)++;
+		text = *end == ',' ? end + 1 : end;
+	}
+}
+
+bool has_token(const char *list, const char *token)
+{
+	if (!list || !*list)
+		return false;
+	const size_t token_length = std::strlen(token);
+	for (const char *p = list; *p;)
+	{
+		while (*p == ',' || *p == ' ')
+			p++;
+		const char *end = p;
+		while (*end && *end != ',')
+			end++;
+		if ((size_t) (end - p) == token_length && std::strncmp(p, token, token_length) == 0)
+			return true;
+		p = end;
+	}
+	return false;
+}
+
+void initialize()
+{
+	if (config.initialized)
+		return;
+	config.initialized = true;
+	config.first_frame = 0;
+	config.last_frame = 0xffffffff;
+
+	const char *path = std::getenv("ZELDA3_SNES9X_TRACE");
+	if (!path || !*path)
+		return;
+	config.output = std::fopen(path, "a");
+	if (!config.output)
+		return;
+
+	const char *events = std::getenv("ZELDA3_SNES9X_TRACE_EVENTS");
+	if (!events || !*events)
+		events = "frame,nmi,rng";
+	if (has_token(events, "frame")) config.events |= TRACE_FRAME;
+	if (has_token(events, "nmi")) config.events |= TRACE_NMI;
+	if (has_token(events, "rng")) config.events |= TRACE_RNG;
+	if (has_token(events, "pc")) config.events |= TRACE_PC;
+	if (has_token(events, "dma")) config.events |= TRACE_DMA;
+	if (has_token(events, "hdma")) config.events |= TRACE_HDMA;
+	if (has_token(events, "ppu")) config.events |= TRACE_PPU;
+	if (has_token(events, "wram")) config.events |= TRACE_WRAM;
+	Zelda3TraceDmaEnabled = (config.events & TRACE_DMA) != 0;
+	Zelda3TraceHdmaEnabled = (config.events & TRACE_HDMA) != 0;
+	Zelda3TracePcEnabled = (config.events & TRACE_PC) != 0;
+	Zelda3TracePpuEnabled = (config.events & TRACE_PPU) != 0;
+	Zelda3TraceWramEnabled = (config.events & (TRACE_RNG | TRACE_WRAM)) != 0;
+
+	const char *frames = std::getenv("ZELDA3_SNES9X_TRACE_FRAMES");
+	if (frames && *frames)
+	{
+		char *end = nullptr;
+		config.first_frame = (uint32) std::strtoul(frames, &end, 10);
+		config.last_frame = config.first_frame;
+		if (*end == '-')
+			config.last_frame = (uint32) std::strtoul(end + 1, nullptr, 10);
+	}
+
+	parse_ranges(std::getenv("ZELDA3_SNES9X_TRACE_PCS"), config.pc, 64, &config.pc_count);
+	parse_ranges(std::getenv("ZELDA3_SNES9X_TRACE_PPU"), config.ppu, 32, &config.ppu_count);
+	parse_ranges(std::getenv("ZELDA3_SNES9X_TRACE_WRAM"), config.wram, 32, &config.wram_count);
+	const char *pixel = std::getenv("ZELDA3_SNES9X_TRACE_PIXEL");
+	Zelda3TracePixelEnabled =
+		pixel && std::sscanf(pixel, "%d,%d", &trace_pixel_x, &trace_pixel_y) == 2;
+}
+
+bool active(uint32 event)
+{
+	initialize();
+	return config.output && (config.events & event) &&
+		IPPU.TotalEmulatedFrames >= config.first_frame &&
+		IPPU.TotalEmulatedFrames <= config.last_frame;
+}
+
+bool includes(const AddressRange *ranges, unsigned count, uint32 value)
+{
+	for (unsigned i = 0; i < count; i++)
+		if (value >= ranges[i].first && value <= ranges[i].last)
+			return true;
+	return false;
+}
+
+void write_machine_state(const char *event)
+{
+	const uint32 return_address =
+		Memory.RAM[(Registers.S.W + 1) & 0xffff] |
+		(Memory.RAM[(Registers.S.W + 2) & 0xffff] << 8) |
+		(Memory.RAM[(Registers.S.W + 3) & 0xffff] << 16);
+	std::fprintf(config.output,
+		"{\"event\":\"%s\",\"run\":%llu,\"frame\":%u,\"v\":%d,\"cycles\":%d,"
+		"\"pc\":%u,\"a\":%u,\"x\":%u,\"y\":%u,\"s\":%u,"
+		"\"carry\":%u,"
+		"\"main\":%u,\"sub\":%u,\"subsub\":%u,\"frame_counter\":%u,\"room\":%u,"
+		"\"spotlight_radius\":%u,\"spotlight_state\":%u,"
+		"\"rng_seed\":%u,\"nmi_latch\":%u,\"nmi_disable\":%u,\"nmi_pending\":%u,"
+		"\"return_address\":%u,"
+		"\"stack1\":%u,\"stack2\":%u,\"stack3\":%u,\"stack4\":%u",
+		event, (unsigned long long) retro_run_index, IPPU.TotalEmulatedFrames,
+		CPU.V_Counter, CPU.Cycles,
+		Registers.PBPC & 0xffffff, Registers.A.W, Registers.X.W, Registers.Y.W,
+		Registers.S.W, Zelda3TraceCpuCarry(),
+		Memory.RAM[0x10], Memory.RAM[0x11], Memory.RAM[0xb0],
+		Memory.RAM[0x1a], Memory.RAM[0xa0] | (Memory.RAM[0xa1] << 8),
+		Memory.RAM[0x067c] | (Memory.RAM[0x067d] << 8),
+		Memory.RAM[0x067e] | (Memory.RAM[0x067f] << 8),
+		Memory.RAM[0x0fa1], Memory.RAM[0x12],
+		Memory.RAM[0x0710], Memory.RAM[0x17], return_address,
+		Memory.RAM[(Registers.S.W + 1) & 0xffff],
+		Memory.RAM[(Registers.S.W + 2) & 0xffff],
+		Memory.RAM[(Registers.S.W + 3) & 0xffff],
+		Memory.RAM[(Registers.S.W + 4) & 0xffff]);
+}
+
+void finish_event()
+{
+	std::fputs("}\n", config.output);
+	std::fflush(config.output);
+}
+
+}
+
+void Zelda3TraceCapturePresentedPpuState()
+{
+	std::memcpy(presented_oam, PPU.OAMData, sizeof(presented_oam));
+	for (int line = 0; line < SNES_HEIGHT_EXTENDED; line++)
+	{
+		presented_obj_tiles[line] = GFX.OBJLines[line].Tiles;
+		presented_obj_flags[line] = GFX.OBJLines[line].RTOFlags;
+		for (int slot = 0; slot < 128; slot++)
+		{
+			presented_obj_sprites[line][slot] = GFX.OBJLines[line].OBJ[slot].Sprite;
+			presented_obj_rows[line][slot] = GFX.OBJLines[line].OBJ[slot].Line;
+		}
+	}
+	std::memcpy(presented_obj_visible_tiles, GFX.OBJVisibleTiles,
+		sizeof(presented_obj_visible_tiles));
+	std::memcpy(presented_obj_widths, GFX.OBJWidths, sizeof(presented_obj_widths));
+	std::memcpy(presented_mode7, LineMatrixData, sizeof(presented_mode7));
+	std::memcpy(presented_windows, scanline_windows, sizeof(presented_windows));
+	std::memcpy(presented_clip, IPPU.Clip, sizeof(presented_clip));
+}
+
+void Zelda3TraceCaptureScanlinePpuState(int line)
+{
+	if (line < 0 || line >= 240)
+		return;
+	scanline_windows[line][0] = PPU.Window1Left;
+	scanline_windows[line][1] = PPU.Window1Right;
+	scanline_windows[line][2] = PPU.Window2Left;
+	scanline_windows[line][3] = PPU.Window2Right;
+}
+
+int Zelda3TracePresentedOamValue(int index)
+{
+	return index >= 0 && index < (int) sizeof(presented_oam) ? presented_oam[index] : -1;
+}
+
+int Zelda3TracePresentedClipValue(int index)
+{
+	constexpr int fields_per_clip = 1 + 6 * 3;
+	if (index < 0 || index >= 2 * 6 * fields_per_clip)
+		return -1;
+	const int clip_index = index / fields_per_clip;
+	const int field = index % fields_per_clip;
+	const ClipData &clip = presented_clip[clip_index / 6][clip_index % 6];
+	if (field == 0)
+		return clip.Count;
+	const int span = (field - 1) / 3;
+	switch ((field - 1) % 3)
+	{
+		case 0: return clip.DrawMode[span];
+		case 1: return clip.Left[span];
+		case 2: return clip.Right[span];
+		default: return -1;
+	}
+}
+
+void Zelda3TraceCapturePresentedPixel(int offset, int palette_index, int main_color,
+	int sub_color, int sub_depth, int result, int z1, int z2)
+{
+	const int target_offset =
+		trace_pixel_y * static_cast<int>(GFX.PPL) + trace_pixel_x;
+	if (!Zelda3TracePixelEnabled || offset != target_offset)
+		return;
+	presented_pixel[0] = offset;
+	presented_pixel[1] = palette_index;
+	presented_pixel[2] = main_color;
+	presented_pixel[3] = sub_color;
+	presented_pixel[4] = sub_depth;
+	presented_pixel[5] = result;
+	presented_pixel[6] = z1;
+	presented_pixel[7] = z2;
+	presented_pixel[8] = GFX.ClipColors;
+	presented_pixel[9] = BG.EnableMath;
+}
+
+int Zelda3TracePresentedPixelValue(int index)
+{
+	return index >= 0 && index < presented_pixel_field_count
+		? presented_pixel[index] : -1;
+}
+
+int Zelda3TracePresentedObjValue(int field, int index)
+{
+	if (index < 0)
+		return -1;
+	switch (field)
+	{
+		case 0:
+			return index < SNES_HEIGHT_EXTENDED * 128
+				? presented_obj_sprites[index / 128][index % 128] : -1;
+		case 1: return index < SNES_HEIGHT_EXTENDED ? presented_obj_tiles[index] : -1;
+		case 2: return index < SNES_HEIGHT_EXTENDED ? presented_obj_flags[index] : -1;
+		case 3: return index < 128 ? presented_obj_visible_tiles[index] : -1;
+		case 4: return index < 128 ? presented_obj_widths[index] : -1;
+		case 5:
+			return index < SNES_HEIGHT_EXTENDED * 128
+				? presented_obj_rows[index / 128][index % 128] : -1;
+		default: return -1;
+	}
+}
+
+int Zelda3TracePresentedMode7Value(int line, int field)
+{
+	if (line < 0 || line >= 240)
+		return -1;
+	const SLineMatrixData &values = presented_mode7[line];
+	switch (field)
+	{
+		case 0: return values.MatrixA;
+		case 1: return values.MatrixB;
+		case 2: return values.MatrixC;
+		case 3: return values.MatrixD;
+		case 4: return values.CentreX;
+		case 5: return values.CentreY;
+		case 6: return values.M7HOFS;
+		case 7: return values.M7VOFS;
+		case 8: return presented_windows[line][0];
+		case 9: return presented_windows[line][1];
+		case 10: return presented_windows[line][2];
+		case 11: return presented_windows[line][3];
+		default: return -1;
+	}
+}
