+	return smp_ledger_overflow;
+}
+
+void Zelda3TraceSmpLedgerIo(int clocks, int clock_before, int clock_after)
+{
+	if (!smp_ledger_active)
+		return;
+	if (smp_ledger_bus_count >= smp_ledger_bus_capacity)
+	{
+		smp_ledger_overflow = 1;
+		return;
+	}
+	int *event = smp_ledger_bus[smp_ledger_bus_count++];
+	event[0] = ZELDA3_TRACE_SMP_LEDGER_IO;
+	event[1] = -1;
+	event[2] = -1;
+	event[3] = clocks;
+	event[4] = clock_before;
+	event[5] = clock_after;
+}
+
+void Zelda3TraceSmpLedgerRead(int kind, int address, int value,
+	int clock_before, int clock_after)
+{
+	if (!smp_ledger_active)
+		return;
+	if (smp_ledger_bus_count >= smp_ledger_bus_capacity)
+	{
+		smp_ledger_overflow = 1;
+		return;
+	}
+	int *event = smp_ledger_bus[smp_ledger_bus_count++];
+	event[0] = kind;
+	event[1] = address;
+	event[2] = value;
+	event[3] = 1;
+	event[4] = clock_before;
+	event[5] = clock_after;
+}
+
+void Zelda3TraceSmpLedgerWrite(int kind, int address, int value,
+	int clock_before, int clock_after)
+{
+	Zelda3TraceSmpLedgerRead(kind, address, value, clock_before, clock_after);
+}
