+  else if(addr >= 0xffc0 && status.iplrom_enable) value = iplrom[addr & 0x3f];
+  else value = apuram[addr];
+  Zelda3TraceSmpLedgerRead(ZELDA3_TRACE_SMP_LEDGER_READ, addr, value,
+    clock_before, clock);
+  return value;
 }
 
 void SMP::op_write(uint16 addr, uint8 data) {
+  int clock_before = clock;
   tick();
   if((addr & 0xfff0) == 0x00f0) mmio_write(addr, data);
   apuram[addr] = data;  //all writes go to RAM, even MMIO writes
+  Zelda3TraceSmpLedgerWrite(ZELDA3_TRACE_SMP_LEDGER_WRITE, addr, data,
+    clock_before, clock);
 }
 
 uint8 SMP::op_readstack()
 {
+  int clock_before = clock;
   tick();
-  return apuram[0x0100 | ++regs.sp];
+  uint16 addr = 0x0100 | ++regs.sp;
+  uint8 value = apuram[addr];
+  Zelda3TraceSmpLedgerRead(ZELDA3_TRACE_SMP_LEDGER_READ_STACK, addr, value,
+    clock_before, clock);
+  return value;
 }
 
 void SMP::op_writestack(uint8 data)
 {
+  int clock_before = clock;
   tick();
-  apuram[0x0100 | regs.sp--] = data;
+  uint16 addr = 0x0100 | regs.sp--;
+  apuram[addr] = data;
+  Zelda3TraceSmpLedgerWrite(ZELDA3_TRACE_SMP_LEDGER_WRITE_STACK, addr, data,
+    clock_before, clock);
 }
 
