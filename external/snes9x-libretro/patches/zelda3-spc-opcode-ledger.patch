+int Zelda3TraceSmpLedgerBegin(int case_id, const int *seed, int seed_count)
+{
+	if (!seed || seed_count != smp_ledger_seed_field_count || case_id < 0)
+		return 0;
+
+	smp_ledger_active = false;
+	smp_ledger_sealed = false;
+	SNES::smp.power();
+	SNES::cpu.reset();
+	for (int address = 0; address < 65536; address++)
+		SNES::smp.apuram[address] = (uint8) ((address * 37 +
+			(address >> 8) * 13 + case_id * 17 + 0x5a) & 0xff);
+	SNES::dsp.power();
+
+	SNES::smp.regs.pc = (uint16) seed[0];
+	SNES::smp.regs.B.a = (uint8) seed[1];
+	SNES::smp.regs.x = (uint8) seed[2];
+	SNES::smp.regs.B.y = (uint8) seed[3];
+	SNES::smp.regs.sp = (uint8) seed[4];
+	SNES::smp.regs.p = (unsigned) seed[5];
+	SNES::smp.status.iplrom_enable = seed[6] != 0;
+	SNES::smp.status.dsp_addr = (uint8) seed[7];
+	SNES::smp.status.ram00f8 = (uint8) seed[8];
+	SNES::smp.status.ram00f9 = (uint8) seed[9];
+	SNES::smp.clock = seed[10];
+	SNES::dsp.clock = seed[11];
+	int field = 12;
+	SNES::smp.timer0.enable = seed[field++] != 0;
+	SNES::smp.timer0.target = (uint8) seed[field++];
+	SNES::smp.timer0.stage1_ticks = (uint8) seed[field++];
+	SNES::smp.timer0.stage2_ticks = (uint8) seed[field++];
+	SNES::smp.timer0.stage3_ticks = (uint8) seed[field++];
+	SNES::smp.timer1.enable = seed[field++] != 0;
+	SNES::smp.timer1.target = (uint8) seed[field++];
+	SNES::smp.timer1.stage1_ticks = (uint8) seed[field++];
+	SNES::smp.timer1.stage2_ticks = (uint8) seed[field++];
+	SNES::smp.timer1.stage3_ticks = (uint8) seed[field++];
+	SNES::smp.timer2.enable = seed[field++] != 0;
+	SNES::smp.timer2.target = (uint8) seed[field++];
+	SNES::smp.timer2.stage1_ticks = (uint8) seed[field++];
+	SNES::smp.timer2.stage2_ticks = (uint8) seed[field++];
+	SNES::smp.timer2.stage3_ticks = (uint8) seed[field++];
+	for (int port = 0; port < 4; port++)
+		SNES::cpu.registers[port] = (uint8) seed[field++];
+
+	SNES::smp.opcode_number = 0x100 | (case_id & 0xff);
+	SNES::smp.opcode_cycle = 0;
+	SNES::smp.rd = 0xa101;
+	SNES::smp.wr = 0xa202;
+	SNES::smp.dp = 0xa303;
+	SNES::smp.sp = 0xa404;
+	SNES::smp.ya = 0xa505;
+	SNES::smp.bit = 0xa606;
+	smp_ledger_case_id = case_id;
+	smp_ledger_step = 0;
+	smp_ledger_overflow = 0;
+	smp_ledger_bus_count = 0;
+	smp_ledger_ram_diff_count = 0;
+	smp_ledger_dsp_diff_count = 0;
+	return 1;
+}
+
+int Zelda3TraceSmpLedgerSetRam(int address, int value)
+{
+	if (smp_ledger_sealed || address < 0 || address >= 65536 || value < 0 || value > 255)
+		return 0;
+	SNES::smp.apuram[address] = (uint8) value;
+	return 1;
+}
+
+int Zelda3TraceSmpLedgerSetDsp(int address, int value)
+{
+	if (smp_ledger_sealed || address < 0 || address >= 128 || value < 0 || value > 255)
+		return 0;
+	SNES::dsp.spc_dsp.write(address, value);
+	return 1;
+}
+
+int Zelda3TraceSmpLedgerSeal()
+{
+	if (smp_ledger_sealed || smp_ledger_case_id < 0)
+		return 0;
+	std::copy_n(SNES::smp.apuram, 65536, smp_ledger_previous_ram);
+	for (int address = 0; address < 128; address++)
+		smp_ledger_previous_dsp[address] = SNES::dsp.spc_dsp.read(address);
+	smp_ledger_active = true;
+	smp_ledger_sealed = true;
+	return 1;
+}
+
+int Zelda3TraceSmpLedgerStep()
+{
+	if (!smp_ledger_active || !smp_ledger_sealed || smp_ledger_overflow)
+		return -1;
+	smp_ledger_bus_count = 0;
+	smp_ledger_ram_diff_count = 0;
+	smp_ledger_dsp_diff_count = 0;
+	Zelda3TraceStepSmpOpcode();
+	smp_ledger_step++;
+	for (int address = 0; address < 65536; address++)
+	{
+		uint8 value = SNES::smp.apuram[address];
+		if (value == smp_ledger_previous_ram[address])
+			continue;
+		if (smp_ledger_ram_diff_count >= smp_ledger_diff_capacity)
+		{
+			smp_ledger_overflow = 1;
+			break;
+		}
+		smp_ledger_ram_diff[smp_ledger_ram_diff_count][0] = address;
+		smp_ledger_ram_diff[smp_ledger_ram_diff_count][1] = value;
+		smp_ledger_ram_diff_count++;
+		smp_ledger_previous_ram[address] = value;
+	}
+	for (int address = 0; address < 128; address++)
+	{
+		uint8 value = SNES::dsp.spc_dsp.read(address);
+		if (value == smp_ledger_previous_dsp[address])
+			continue;
+		if (smp_ledger_dsp_diff_count >= smp_ledger_diff_capacity)
+		{
+			smp_ledger_overflow = 1;
+			break;
+		}
+		smp_ledger_dsp_diff[smp_ledger_dsp_diff_count][0] = address;
+		smp_ledger_dsp_diff[smp_ledger_dsp_diff_count][1] = value;
+		smp_ledger_dsp_diff_count++;
+		smp_ledger_previous_dsp[address] = value;
+	}
+	return smp_ledger_overflow ? -1 : (int) SNES::smp.opcode_cycle;
 }
 
+int Zelda3TraceSmpLedgerStateValue(int field)
+{
+	if (!smp_ledger_sealed || field < 0 || field >= smp_ledger_state_field_count)
+		return -1;
+	switch (field)
+	{
+	case 0: return smp_ledger_case_id;
+	case 1: return SNES::smp.regs.pc;
+	case 2: return SNES::smp.regs.B.a;
+	case 3: return SNES::smp.regs.x;
+	case 4: return SNES::smp.regs.B.y;
+	case 5: return SNES::smp.regs.sp;
+	case 6: return SNES::smp.regs.p;
+	case 7: return SNES::smp.opcode_number;
+	case 8: return SNES::smp.opcode_cycle;
+	case 9: return SNES::smp.rd;
+	case 10: return SNES::smp.wr;
+	case 11: return SNES::smp.dp;
+	case 12: return SNES::smp.sp;
+	case 13: return SNES::smp.ya;
+	case 14: return SNES::smp.bit;
+	case 15: return SNES::smp.clock;
+	case 16: return SNES::dsp.clock;
+	case 17: return SNES::smp.status.iplrom_enable;
+	case 18: return SNES::smp.status.dsp_addr;
+	case 19: return SNES::smp.status.ram00f8;
+	case 20: return SNES::smp.status.ram00f9;
+	case 21: return SNES::smp.timer0.enable;
+	case 22: return SNES::smp.timer0.target;
+	case 23: return SNES::smp.timer0.stage1_ticks;
+	case 24: return SNES::smp.timer0.stage2_ticks;
+	case 25: return SNES::smp.timer0.stage3_ticks;
+	case 26: return SNES::smp.timer1.enable;
+	case 27: return SNES::smp.timer1.target;
+	case 28: return SNES::smp.timer1.stage1_ticks;
+	case 29: return SNES::smp.timer1.stage2_ticks;
+	case 30: return SNES::smp.timer1.stage3_ticks;
+	case 31: return SNES::smp.timer2.enable;
+	case 32: return SNES::smp.timer2.target;
+	case 33: return SNES::smp.timer2.stage1_ticks;
+	case 34: return SNES::smp.timer2.stage2_ticks;
+	case 35: return SNES::smp.timer2.stage3_ticks;
+	case 36: case 37: case 38: case 39:
+		return SNES::cpu.registers[field - 36];
+	case 40: case 41: case 42: case 43:
+		return SNES::smp.apuram[0xf4 + field - 40];
+	case 44: return smp_ledger_step;
+	case 45: return smp_ledger_overflow;
+	default: return SNES::dsp.spc_dsp.read(field - smp_ledger_scalar_state_field_count);
+	}
+}
+
+int Zelda3TraceSmpLedgerBusCount()
+{
+	return smp_ledger_bus_count;
+}
+
+int Zelda3TraceSmpLedgerBusValue(int event, int field)
+{
+	return event >= 0 && event < smp_ledger_bus_count &&
+		field >= 0 && field < smp_ledger_bus_field_count
+		? smp_ledger_bus[event][field] : -1;
+}
