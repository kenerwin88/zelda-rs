 uint8 SMP::op_read(uint16 addr) {
+  int clock_before = clock;
   tick();
-  if((addr & 0xfff0) == 0x00f0) return mmio_read(addr);
-  if(addr >= 0xffc0 && status.iplrom_enable) return iplrom[addr & 0x3f];
