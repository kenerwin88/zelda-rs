+{
+	return difference >= 0 && difference < smp_ledger_ram_diff_count &&
+		field >= 0 && field < 2 ? smp_ledger_ram_diff[difference][field] : -1;
+}
+
+int Zelda3TraceSmpLedgerDspDiffCount()
+{
+	return smp_ledger_dsp_diff_count;
+}
+
+int Zelda3TraceSmpLedgerDspDiffValue(int difference, int field)
+{
+	return difference >= 0 && difference < smp_ledger_dsp_diff_count &&
