+#include <algorithm>
 #include <cmath>
 #include <vector>
 #include "../snes9x.h"
@@ -514,4 +515,284 @@
     S9xSetSoundMute(false);
 
     return true;
+}
+
+
+namespace {
+constexpr int state_capacity = 1024;
+constexpr int diff_capacity = 512;
+constexpr int sample_capacity = 32;
+constexpr int suboperation_capacity = 1024;
+constexpr int profile_preroll = 256;
+bool ledger_mode = false;
+bool active = false;
+int overflow = 0;
+int state_size = 0;
+uint8 state[state_capacity] = {};
+uint8 previous_ram[65536] = {};
+int ram_diff_count = 0;
+int ram_diff[diff_capacity][2] = {};
+int sample_count = 0;
+int samples[sample_capacity][2] = {};
+int suboperation_count = 0;
+int suboperations[suboperation_capacity][3] = {};
+int clock_before = 0;
+int clock_after = 0;
+int previous_interpolation_method = 0;
+int previous_separate_echo_buffer = 0;
+int ledger_interpolation_method = 0;
+int ledger_separate_echo_buffer = 0;
+uint64 branch_evaluated_mask = 0;
+uint64 branch_taken_mask = 0;
+uint64 branch_not_taken_mask = 0;
+}
+
+int Zelda3TraceDspLedgerAbiVersion() { return 2; }
+int Zelda3TraceDspLedgerStateCapacity() { return state_capacity; }
+
+static bool Zelda3TraceDspLedgerCaptureState()
+{
+	state_size = SNES::dsp.spc_dsp.zelda3_ledger_copy_state(state, state_capacity);
+	return state_size >= 0 && state_size <= state_capacity;
+}
+
+int Zelda3TraceDspLedgerBegin(int profile, int phase, int capture)
+{
+	if (profile < 0 || profile > 1 || phase < 0 || phase >= 32 ||
+		capture < 0 || capture > 1)
+		return 0;
+	ledger_mode = true;
+	previous_interpolation_method = Settings.InterpolationMethod;
+	previous_separate_echo_buffer = Settings.SeparateEchoBuffer;
+	Settings.InterpolationMethod = 2;
+	Settings.SeparateEchoBuffer = false;
+	ledger_interpolation_method = Settings.InterpolationMethod;
+	ledger_separate_echo_buffer = Settings.SeparateEchoBuffer;
+	active = false;
+	overflow = 0;
+	ram_diff_count = 0;
+	sample_count = 0;
+	suboperation_count = 0;
+	branch_evaluated_mask = 0;
+	branch_taken_mask = 0;
+	branch_not_taken_mask = 0;
+	SNES::smp.power();
+	for (int address = 0; address < 65536; address++)
+		SNES::smp.apuram[address] = (uint8) ((address * 37 +
+			(address >> 8) * 13 + profile * 97 + 0x5a) & 0xff);
+	for (int voice = 0; voice < 8; voice++)
+	{
+		int const directory = 0x2000 + voice * 4;
+		int const brr = 0x3000 + voice * 0x20;
+		SNES::smp.apuram[directory + 0] = brr & 0xff;
+		SNES::smp.apuram[directory + 1] = brr >> 8;
+		SNES::smp.apuram[directory + 2] = brr & 0xff;
+		SNES::smp.apuram[directory + 3] = brr >> 8;
+		SNES::smp.apuram[brr] = voice & 1 ? 0 : 3;
+	}
+	SNES::dsp.power();
+	if (!SNES::dsp.spc_dsp.zelda3_ledger_seed_profile(profile))
+		return 0;
+	if (profile == 0)
+	{
+		// Voice 6 reaches a direct GAIN envelope through the real pipeline,
+		// then a source write selects mode 7 with hidden_env already >= $600.
+		SNES::dsp.write(0x4c, 0xff);
+		SNES::dsp.clock = 256;
+		SNES::dsp.synchronize();
+		SNES::dsp.write(0x67, 0xff);
+		SNES::dsp.clock = profile_preroll;
+		SNES::dsp.synchronize();
+		SNES::dsp.write(0x4c, 0x01);
+		SNES::dsp.clock = phase;
+	}
+	else
+	{
+		SNES::dsp.clock = profile_preroll + phase;
+	}
+	SNES::dsp.synchronize();
+	sample_count = 0;
+	std::copy_n(SNES::smp.apuram, 65536, previous_ram);
+	state_size = 0;
+	if (capture && !Zelda3TraceDspLedgerCaptureState())
+		return 0;
+	clock_before = SNES::dsp.clock;
+	clock_after = SNES::dsp.clock;
+	active = capture != 0;
+	return 1;
 }
+
+void Zelda3TraceDspLedgerEnd()
+{
+	active = false;
+	ledger_mode = false;
+	Settings.InterpolationMethod = previous_interpolation_method;
+	Settings.SeparateEchoBuffer = previous_separate_echo_buffer;
+}
+
+int Zelda3TraceDspLedgerOperate(int operation, int debt, int address, int value)
+{
+	if (!ledger_mode || overflow || operation < 0 || operation > 3 || debt < 0 ||
+		debt > 256 || address < 0 || address > 255 || value < 0 || value > 255)
+		return -1;
+	sample_count = 0;
+	suboperation_count = 0;
+	branch_evaluated_mask = 0;
+	branch_taken_mask = 0;
+	branch_not_taken_mask = 0;
+	clock_before = SNES::dsp.clock;
+	SNES::dsp.clock += debt;
+	int result = 0;
+	if (operation == 0)
+		SNES::dsp.synchronize();
+	else if (operation == 1)
+	{
+		SNES::smp.status.dsp_addr = address;
+		result = SNES::smp.mmio_read(0xf3);
+	}
+	else
+	{
+		SNES::smp.status.dsp_addr = address;
+		SNES::smp.mmio_write(0xf3, value);
+		result = value;
+	}
+	clock_after = SNES::dsp.clock;
+	ram_diff_count = 0;
+	for (int address_index = 0; address_index < 65536; address_index++)
+	{
+		const uint8 current = SNES::smp.apuram[address_index];
+		if (current == previous_ram[address_index])
+			continue;
+		if (ram_diff_count >= diff_capacity)
+		{
+			overflow = 1;
+			break;
+		}
+		ram_diff[ram_diff_count][0] = address_index;
+		ram_diff[ram_diff_count][1] = current;
+		ram_diff_count++;
+		previous_ram[address_index] = current;
+	}
+	state_size = 0;
+	if (active && !Zelda3TraceDspLedgerCaptureState())
+		overflow = 1;
+	return overflow ? -1 : result;
+}
+
+int Zelda3TraceDspLedgerFinalizeCapture()
+{
+	return ledger_mode && Zelda3TraceDspLedgerCaptureState() ? 1 : 0;
+}
+
+int Zelda3TraceDspLedgerStateSize() { return state_size; }
+int Zelda3TraceDspLedgerStateByte(int index)
+{
+	return ledger_mode && index >= 0 && index < state_size ? state[index] : -1;
+}
+int Zelda3TraceDspLedgerCopyRam(uint8 *out, int capacity)
+{
+	if (!ledger_mode || !out || capacity < 65536)
+		return -1;
+	std::copy_n(SNES::smp.apuram, 65536, out);
+	return 65536;
+}
+int Zelda3TraceDspLedgerRamDiffCount() { return ram_diff_count; }
+int Zelda3TraceDspLedgerRamDiffValue(int difference, int field)
+{
+	return difference >= 0 && difference < ram_diff_count && field >= 0 && field < 2
+		? ram_diff[difference][field] : -1;
+}
+int Zelda3TraceDspLedgerSampleCount() { return sample_count; }
+int Zelda3TraceDspLedgerSampleValue(int sample, int channel)
+{
+	return sample >= 0 && sample < sample_count && channel >= 0 && channel < 2
+		? samples[sample][channel] : -1;
+}
+int Zelda3TraceDspLedgerSubOperationCount() { return suboperation_count; }
+int Zelda3TraceDspLedgerSubOperationValue(int operation, int field)
+{
+	return operation >= 0 && operation < suboperation_count && field >= 0 && field < 3
+		? suboperations[operation][field] : -1;
+}
+int Zelda3TraceDspLedgerPhase() { return SNES::dsp.spc_dsp.zelda3_debug_value(7); }
+int Zelda3TraceDspLedgerClockBefore() { return clock_before; }
+int Zelda3TraceDspLedgerClockAfter() { return clock_after; }
+int Zelda3TraceDspLedgerConfigValue(int field)
+{
+	if (field == 0)
+		return ledger_separate_echo_buffer;
+	if (field == 3)
+		return ledger_interpolation_method;
+	return SNES::dsp.spc_dsp.zelda3_ledger_config_value(field);
+}
+uint64 Zelda3TraceDspLedgerBranchEvaluatedMask() { return branch_evaluated_mask; }
+uint64 Zelda3TraceDspLedgerBranchTakenMask() { return branch_taken_mask; }
+uint64 Zelda3TraceDspLedgerBranchNotTakenMask() { return branch_not_taken_mask; }
+int Zelda3TraceDspLedgerOverflow() { return overflow; }
+
+namespace SNES {
+void Zelda3TraceDspLedgerBranch(int branch, bool taken)
+{
+	if (active && branch >= 0 && branch < 64)
+	{
+		branch_evaluated_mask |= (uint64) 1 << branch;
+		if (taken)
+			branch_taken_mask |= (uint64) 1 << branch;
+		else
+			branch_not_taken_mask |= (uint64) 1 << branch;
+	}
+}
+bool Zelda3TraceDspLedgerCapturing() { return active; }
+bool Zelda3TraceDspLedgerMode() { return ledger_mode; }
+void Zelda3TraceDspLedgerSample(int left, int right)
+{
+	if (!ledger_mode)
+		return;
+	if (sample_count >= sample_capacity)
+	{
+		overflow = 1;
+		return;
+	}
+	samples[sample_count][0] = left;
+	samples[sample_count][1] = right;
+	sample_count++;
+}
+void Zelda3TraceDspLedgerSubOperation(int kind, int voice, int argument)
+{
+	if (!active)
+		return;
+	if (suboperation_count >= suboperation_capacity)
+	{
+		overflow = 1;
+		return;
+	}
+	suboperations[suboperation_count][0] = kind;
+	suboperations[suboperation_count][1] = voice;
+	suboperations[suboperation_count][2] = argument;
+	suboperation_count++;
+}
+}
+
+extern "C" int zelda3_snes9x_debug_dsp_ledger_abi_version() { return Zelda3TraceDspLedgerAbiVersion(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_state_capacity() { return Zelda3TraceDspLedgerStateCapacity(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_begin(int profile, int phase, int capture) { return Zelda3TraceDspLedgerBegin(profile, phase, capture); }
+extern "C" void zelda3_snes9x_debug_dsp_ledger_end() { Zelda3TraceDspLedgerEnd(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_operate(int operation, int debt, int address, int value) { return Zelda3TraceDspLedgerOperate(operation, debt, address, value); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_finalize_capture() { return Zelda3TraceDspLedgerFinalizeCapture(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_state_size() { return Zelda3TraceDspLedgerStateSize(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_state_byte(int index) { return Zelda3TraceDspLedgerStateByte(index); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_copy_ram(uint8_t *out, int capacity) { return Zelda3TraceDspLedgerCopyRam(out, capacity); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_ram_diff_count() { return Zelda3TraceDspLedgerRamDiffCount(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_ram_diff_value(int difference, int field) { return Zelda3TraceDspLedgerRamDiffValue(difference, field); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_sample_count() { return Zelda3TraceDspLedgerSampleCount(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_sample_value(int sample, int channel) { return Zelda3TraceDspLedgerSampleValue(sample, channel); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_suboperation_count() { return Zelda3TraceDspLedgerSubOperationCount(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_suboperation_value(int operation, int field) { return Zelda3TraceDspLedgerSubOperationValue(operation, field); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_phase() { return Zelda3TraceDspLedgerPhase(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_clock_before() { return Zelda3TraceDspLedgerClockBefore(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_clock_after() { return Zelda3TraceDspLedgerClockAfter(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_config_value(int field) { return Zelda3TraceDspLedgerConfigValue(field); }
+extern "C" uint64_t zelda3_snes9x_debug_dsp_ledger_branch_evaluated_mask() { return Zelda3TraceDspLedgerBranchEvaluatedMask(); }
+extern "C" uint64_t zelda3_snes9x_debug_dsp_ledger_branch_taken_mask() { return Zelda3TraceDspLedgerBranchTakenMask(); }
+extern "C" uint64_t zelda3_snes9x_debug_dsp_ledger_branch_not_taken_mask() { return Zelda3TraceDspLedgerBranchNotTakenMask(); }
+extern "C" int zelda3_snes9x_debug_dsp_ledger_overflow() { return Zelda3TraceDspLedgerOverflow(); }
