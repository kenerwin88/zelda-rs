+static void zelda3_ledger_copy_bytes(unsigned char** io, void* state, size_t size)
+{
+	memcpy(*io, state, size);
+	*io += size;
+}
+
+int SPC_DSP::zelda3_ledger_copy_state(unsigned char* out, int capacity)
+{
+	if (!out || capacity < state_size)
+		return -1;
+	unsigned char* cursor = out;
+	copy_state(&cursor, zelda3_ledger_copy_bytes);
+	return (int) (cursor - out);
+}
+
+int SPC_DSP::zelda3_ledger_config_value(int field) const
+{
+	if (field == 0)
+		return Settings.SeparateEchoBuffer;
+	if (field == 1)
+		return stereo_switch;
+	if (field == 2)
+		return m.mute_mask;
+	if (field == 3)
+		return Settings.InterpolationMethod;
+	return -1;
+}
+
+int SPC_DSP::zelda3_ledger_seed_profile(int profile)
+{
+	if (profile < 0 || profile > 1 || !m.ram)
+		return 0;
+
+	uint8_t regs[register_count];
+	memset(regs, 0, sizeof regs);
+	regs[r_flg] = profile ? 0xe0 : 0x1f;
+	regs[r_mvoll] = 0x50;
+	regs[r_mvolr] = 0x58;
+	regs[r_evoll] = 0x20;
+	regs[r_evolr] = 0x28;
+	regs[r_efb] = 0x30;
+	regs[r_pmon] = profile ? 0x00 : 0xfe;
+	regs[r_non] = profile ? 0x00 : 0x55;
+	regs[r_eon] = profile ? 0x00 : 0xaa;
+	regs[r_kon] = 0x00;
+	regs[r_koff] = profile ? 0x0f : 0x00;
+	regs[r_dir] = 0x20;
+	regs[r_esa] = 0x40;
+	regs[r_edl] = profile ? 1 : 0;
+	static uint8_t const active_gain[voice_count] = {
+		0x7f, 0x60, 0x81, 0xa2, 0xc3, 0xe4, 0x7f, 0x7f
+	};
+	for (int voice = 0; voice < voice_count; voice++)
+	{
+		uint8_t* v = &regs[voice * 0x10];
+		v[v_voll] = 0x30 + voice;
+		v[v_volr] = 0x38 + voice;
+		v[v_pitchl] = 0x40 + voice;
+		v[v_pitchh] = 0x08;
+		v[v_srcn] = voice;
+		v[v_adsr0] = !profile && (voice == 0 || voice == 7) ? 0x8f : 0x00;
+		v[v_adsr1] = 0x5f;
+		v[v_gain] = profile ? 0x7f : active_gain[voice];
+	}
+	for (int address = 0; address < register_count; address++)
+		write(address, regs[address]);
+	return 1;
+}
